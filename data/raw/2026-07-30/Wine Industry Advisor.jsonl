igh.", "published_at": "2026-07-29 20:48:45+00:00", "source_name": "Wine Industry Advisor", "source_type": "media", "language": "en", "content_type": "market_report", "country": "US", "continent": "NEW_WORLD", "region": "Americas/North/USA", "producer_role": "trade_media", "trust_tier": "T3_professional", "info_purpose": ["P2_market_analysis"], "collection_tier": "C1_rss"}
